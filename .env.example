# ============================================================
#  YC Launch Monitor — .env configuration
#  Copy this file to `.env` and fill in your values.
#  NOTE: `.env` is gitignored — never commit it.
#  The bot works out of the box with just the two official
#  sources (YC Directory + Speedrun) and NO keys.
#  Add Slack + X/LinkedIn keys to enable alerting & early detection.
# ============================================================

# --- Slack (REQUIRED to actually send alerts) ---
# Bot token from api.slack.com/apps -> your app -> OAuth & Permissions.
YC_SLACK_BOT_TOKEN=xoxb-...
# Channel name/ID (e.g. #yc-launch-monitor or C0123ABC) OR your user ID for a DM.
YC_SLACK_CHANNEL=#yc-launch-monitor
# Optional: @mention a user/group on new alerts.
YC_SLACK_MENTION=

# --- X / Twitter (REQUIRED for early-detection alerts) ---
# Bearer token from developer.x.com (Basic tier ~$100/mo).
YC_X_BEARER_TOKEN=

# --- LinkedIn (optional, pluggable adapter) ---
YC_LINKEDIN_API_KEY=
YC_LINKEDIN_ENDPOINT=

# --- Pond (optional) ---
YC_POND_AGENT_ID=

# --- Scheduling ---
# Minutes between polls in --loop mode. Default 480 = every 8 hours.
YC_SCHEDULE_INTERVAL_MINUTES=480
