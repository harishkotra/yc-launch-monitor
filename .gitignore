# ============================================================
#  YC Launch Monitor — .gitignore
#  Everything here is NOT required in GitHub (regenerated locally).
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Runtime / generated artifacts (regenerated on demand) ---
state.db
pond_report.json
demo/out/
demo/slack_preview.html
demo/slack_preview.png

# --- Secrets — never commit ---
config.yaml
.env
.env.*
!.env.example

# --- OS / editor / misc ---
.DS_Store
*.log
.idea/
.vscode/
*.swp
